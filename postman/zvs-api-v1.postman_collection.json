    {
      "name": "login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Stores the access_token in an environment variable",
              "let accessToken = '';",
              "try {",
              "    accessToken = pm.response.json().access_token;",
              "    pm.environment.set(\"access_token\", accessToken);",
              "} catch (JSONError) {",
              "    console.error(\"Failed to parse JSON response:\", JSONError);",
              "}",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{ \n  \"api_key\": \"{{api_key}}\",\n  \"api_secret\": \"{{api_secret}}\"\n} \n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{host}}/api/login",
          "host": [
            "{{host}}"
          ],
          "path": [
            "api",
            "login"
          ]
        }
      },
      "response": []
    },
